{
  "name": "mova",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=mova-frontend",
    "dev:backend": "turbo run dev --filter=streaming-backend",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
